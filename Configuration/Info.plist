<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>WHOOP</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>WHOOP</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>WHOOP can read a nearby heart-rate sensor when you choose to connect.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Inter.ttf</string>
		<string>dinpro_regular.otf</string>
		<string>dinpro_medium.otf</string>
		<string>dinpro_bold.otf</string>
		<string>proxima_nova_regular.otf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>Import heart rate, sleep, activity and breathing measurements from Apple Health into your local daily dashboard. You choose which measurements to share.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>local.whoop.reconstruction.oauth</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>whooplocal</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Record a video with your live workout measurements when you choose to open Live camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Include audio in your Live workout videos when you choose microphone recording.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save a photo overlay or workout video to your photo library when you tap Save.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
</dict>
</plist>
