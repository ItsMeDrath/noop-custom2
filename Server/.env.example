# Server only. Never copy credentials or encryption keys into the iOS target.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Public HTTPS origin with no path, query, fragment, or credentials.
# Register EXACTLY https://bridge.example.com/oauth/callback in WHOOP dashboard.
PUBLIC_ORIGIN=https://bridge.example.com
# Generate locally with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_PATH=./data/sessions.enc
# Listen behind your HTTPS reverse proxy; never expose this plain HTTP listener.
HOST=127.0.0.1
PORT=8787

# Nutrition AI: server-only, OpenAI-compatible chat-completions endpoint.
# Never place these in the iOS app, browser code, source control, or backups.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
